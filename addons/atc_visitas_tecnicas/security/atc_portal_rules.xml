<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contratistas (usuarios de portal): solo ven las instalaciones de su
         contratista. Solo tienen lectura; los cambios entran por el
         controlador del portal, que filtra los campos permitidos. -->
    <record id="rule_atc_visita_portal_contratista" model="ir.rule">
        <field name="name">Instalaciones: solo las del contratista del usuario (portal)</field>
        <field name="model_id" ref="model_atc_visita"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('tipo_orden', '=', 'instalacion'), ('contratista_id.user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
