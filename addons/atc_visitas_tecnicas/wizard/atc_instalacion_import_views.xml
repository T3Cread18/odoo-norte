<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atc_instalacion_import_form" model="ir.ui.view">
        <field name="name">atc.instalacion.import.form</field>
        <field name="model">atc.instalacion.import</field>
        <field name="arch" type="xml">
            <form string="Importar instalaciones desde Excel">
                <field name="state" invisible="1"/>
                <!-- Paso 1: cargar archivo -->
                <group invisible="state == 'done'">
                    <div colspan="2" class="alert alert-info" role="alert">
                        Sube el Excel de <b>órdenes de instalación pendientes</b>
                        (columnas TIPO SERVICIO, RIF, RAZON SOCIAL, TLF. MOVIL,
                        TLF. FIJO, ANTIGUEDAD, TECNICO, REFERENCIA). Se crean las
                        órdenes nuevas asignadas a su contratista; las que ya están
                        abiertas (misma cédula) solo se actualizan. Los contratistas
                        y tipos de servicio nuevos se crean solos.
                    </div>
                    <field name="archivo" filename="nombre_archivo"
                           widget="binary"/>
                    <field name="nombre_archivo" invisible="1"/>
                    <field name="fecha_reporte"/>
                </group>
                <!-- Paso 2: resultado -->
                <group invisible="state != 'done'">
                    <field name="resultado" nolabel="1" readonly="1"
                           widget="text"/>
                </group>
                <footer>
                    <button name="action_importar" type="object"
                            string="Importar" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel" invisible="state == 'done'"/>
                    <button string="Cerrar" class="btn-primary"
                            special="cancel" invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_atc_instalacion_import" model="ir.actions.act_window">
        <field name="name">Importar instalaciones</field>
        <field name="res_model">atc.instalacion.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
