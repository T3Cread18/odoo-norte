<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_atc_franquicias" model="ir.ui.view">
        <field name="name">res.users.form.atc.franquicias</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page name="atc_franquicias" string="Franquicias ATC">
                    <group>
                        <field name="atc_franquicia_ids" widget="many2many_tags" options="{'no_create': True}"
                               placeholder="Todas (sin restricción)"/>
                    </group>
                    <div class="text-muted">
                        Con el rol ATC solo verá las órdenes de estas franquicias (y las En LOS de sus OLTs NOC).
                        Vacío: ve todas.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
