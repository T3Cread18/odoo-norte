<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORMULARIO con chatter (mensajes, notas, historial) -->
    <record id="view_atc_visita_form" model="ir.ui.view">
        <field name="name">atc.visita.form</field>
        <field name="model">atc.visita</field>
        <field name="arch" type="xml">
            <form string="Orden ATC">
                <header>
                    <button name="action_abrir_asignar" type="object"
                            string="Asignar técnico" class="btn-primary"
                            invisible="estado in ('realizada', 'no_realizada')"/>
                    <button name="action_marcar_realizada" type="object"
                            string="Marcar realizada" class="btn-primary"
                            invisible="estado in ('realizada', 'no_realizada', 'garantia')"/>
                    <button name="action_garantia_atendida" type="object"
                            string="Garantía atendida" class="btn-primary"
                            invisible="estado != 'garantia'"/>
                    <button name="action_marcar_pendiente" type="object"
                            string="Reabrir" class="btn-secondary"
                            invisible="estado not in ('realizada', 'no_realizada')"/>
                    <field name="estado" widget="statusbar"
                           statusbar_visible="pendiente,asignada,realizada"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="estado != 'garantia'">
                        <b>Visita por garantía</b> desde <field name="garantia_desde" readonly="1" class="d-inline"/>:
                        <field name="garantia_motivo" readonly="1" class="d-inline"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Referencia (puedes editarla)"/></h1>
                    </div>
                    <group>
                        <group string="Cliente">
                            <field name="cedula"
                                   required="tipo_orden == 'visita' and not id"
                                   placeholder="Escribe la cédula y se traerá el cliente"/>
                            <field name="nombre"
                                   placeholder="Nombre del cliente (si la cédula es nueva, se crea el contacto)"/>
                            <field name="cliente_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Orden">
                            <field name="tipo_orden"/>
                            <field name="tecnico_asignado_ids" widget="many2many_tags"
                                   placeholder="Escribe un nombre para crear el técnico"/>
                            <field name="vehiculo_id" options="{'no_quick_create': True}"/>
                            <field name="tecnico_id" widget="many2one_avatar_user"/>
                            <field name="fecha"/>
                            <field name="franquicia_id" options="{'no_create': True}" domain="[('child_ids', '=', False)]"/>
                            <field name="zona_id"
                                   domain="franquicia_id and ['|', ('franquicia_id', '=', False), ('franquicia_id', '=', franquicia_id)] or []"/>
                            <field name="vgt_id" options="{'no_create': True}"/>
                            <field name="vgt_zona_ids" invisible="not vgt_id"
                                   widget="many2many_tags" readonly="1"
                                   string="Zonas de la VGT"
                                   help="Zonas a las que ya está enlazada esta VGT."/>
                            <field name="direccion"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <group invisible="tipo_orden != 'instalacion'">
                        <group string="Instalación">
                            <field name="contratista_id"/>
                            <field name="vendedor_id"/>
                            <field name="tipo_servicio_id"/>
                            <field name="telefono_movil" widget="phone"/>
                            <field name="telefono_fijo" widget="phone"/>
                        </group>
                        <group string="Fechas">
                            <field name="fecha_asignacion"/>
                            <field name="dias_pendiente"/>
                            <field name="fecha_programada"/>
                            <field name="fecha_instalacion"/>
                            <field name="garantia_hasta" invisible="not garantia_hasta"/>
                        </group>
                        <group string="Reporte del contratista">
                            <field name="tecnico_contratista"/>
                            <field name="serial_onu"/>
                            <field name="precinto"/>
                            <field name="potencia_rx"/>
                        </group>
                        <group string="Red y material">
                            <field name="caja_nap"/>
                            <field name="puerto_nap"/>
                            <field name="metros_fibra"/>
                        </group>
                        <group string="Ubicación">
                            <label for="cliente_latitud" string="Cliente"/>
                            <div class="o_row">
                                <field name="cliente_latitud" placeholder="Latitud"/>
                                <field name="cliente_longitud" placeholder="Longitud"/>
                                <field name="cliente_mapa_url" widget="url" text="Ver en mapa"
                                       invisible="not cliente_mapa_url"/>
                            </div>
                            <label for="nap_latitud" string="Caja NAP"/>
                            <div class="o_row">
                                <field name="nap_latitud" placeholder="Latitud"/>
                                <field name="nap_longitud" placeholder="Longitud"/>
                                <field name="nap_mapa_url" widget="url" text="Ver en mapa"
                                       invisible="not nap_mapa_url"/>
                            </div>
                        </group>
                        <field name="observaciones_contratista" colspan="2"
                               placeholder="Observaciones del contratista"/>
                        <field name="motivo_no_realizada_ids" colspan="2"
                               widget="many2many_tags"
                               options="{'color_field': 'color', 'no_create': True}"
                               invisible="estado != 'no_realizada' and not motivo_no_realizada_ids"
                               required="estado == 'no_realizada'"/>
                        <field name="fecha_no_realizada" invisible="not fecha_no_realizada"/>
                    </group>
                    <separator string="Historial de garantías" invisible="not garantia_ids"/>
                    <field name="garantia_ids" readonly="1" invisible="not garantia_ids">
                        <list>
                            <field name="fecha_inicio"/>
                            <field name="motivo"/>
                            <field name="contratista_id" optional="hide"/>
                            <field name="fecha_cierre"/>
                            <field name="cerrada_por_id" widget="many2one_avatar_user"/>
                            <field name="duracion_horas"/>
                            <field name="resultado" widget="badge"
                                   decoration-danger="resultado == 'abierta'"
                                   decoration-success="resultado in ('atendida', 'recuperada')"/>
                        </list>
                    </field>
                    <separator string="Descripción"/>
                    <field name="descripcion" widget="html"
                           placeholder="Detalle de la orden: observaciones, trabajo realizado, materiales, etc."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- WIZARD: asignar técnico(s) -->
    <record id="view_atc_visita_asignar_form" model="ir.ui.view">
        <field name="name">atc.visita.asignar.form</field>
        <field name="model">atc.visita.asignar</field>
        <field name="arch" type="xml">
            <form string="Asignar técnico">
                <group>
                    <field name="visita_id" invisible="1"/>
                    <field name="es_instalacion" invisible="1"/>
                    <field name="contratista_id" invisible="not es_instalacion"
                           options="{'no_create': True}"/>
                    <field name="tecnico_asignado_ids" widget="many2many_tags"
                           placeholder="Escribe un nombre para crear el técnico"/>
                    <field name="vehiculo_id" options="{'no_quick_create': True}"/>
                </group>
                <footer>
                    <button name="action_asignar" type="object"
                            string="Asignar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- LISTA -->
    <record id="view_atc_visita_list" model="ir.ui.view">
        <field name="name">atc.visita.list</field>
        <field name="model">atc.visita</field>
        <field name="arch" type="xml">
            <list string="Órdenes ATC" decoration-muted="estado in ('realizada', 'no_realizada')">
                <field name="fecha"/>
                <field name="tipo_orden" widget="badge" optional="show"/>
                <field name="cedula"/>
                <field name="nombre"/>
                <field name="cliente_id" optional="hide"/>
                <field name="franquicia_id" optional="show"/>
                <field name="zona_id"/>
                <field name="vgt_id" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="direccion" optional="show"/>
                <field name="tecnico_asignado_ids" widget="many2many_tags" optional="show"/>
                <field name="vehiculo_id" optional="hide"/>
                <field name="tecnico_id" widget="many2one_avatar_user" optional="show"/>
                <field name="estado" widget="badge"
                       decoration-success="estado == 'realizada'"
                       decoration-info="estado == 'asignada'"
                       decoration-warning="estado == 'pendiente'"
                       decoration-danger="estado == 'garantia'"/>
            </list>
        </field>
    </record>

    <!-- KANBAN por etapas -->
    <record id="view_atc_visita_kanban" model="ir.ui.view">
        <field name="name">atc.visita.kanban</field>
        <field name="model">atc.visita</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado" class="o_kanban_small_column"
                    quick_create="false">
                <field name="estado"/>
                <field name="tipo_orden"/>
                <field name="nombre"/>
                <field name="cedula"/>
                <field name="franquicia_id"/>
                <field name="zona_id"/>
                <field name="vgt_id"/>
                <field name="tag_ids"/>
                <field name="tecnico_asignado_ids"/>
                <field name="vehiculo_id"/>
                <field name="tecnico_id"/>
                <field name="fecha"/>
                <field name="contratista_id"/>
                <field name="dias_pendiente"/>
                <templates>
                    <t t-name="card">
                        <span class="badge text-bg-secondary float-end"><field name="tipo_orden"/></span>
                        <div class="fw-bold fs-6"><field name="nombre"/></div>
                        <div t-if="record.cedula.value" class="text-muted small">CI: <field name="cedula"/></div>
                        <div t-if="record.franquicia_id.value" class="small"><i class="fa fa-building-o me-1" title="Franquicia"/><field name="franquicia_id"/></div>
                        <div t-if="record.zona_id.value" class="small"><i class="fa fa-map-marker me-1" title="Zona"/><field name="zona_id"/></div>
                        <div t-if="record.vgt_id.value" class="small"><i class="fa fa-file-text-o me-1" title="VGT"/><field name="vgt_id"/></div>
                        <div t-if="record.contratista_id.value" class="small"><i class="fa fa-briefcase me-1" title="Contratista"/><field name="contratista_id"/></div>
                        <div t-if="record.tipo_orden.raw_value == 'instalacion' and ['pendiente', 'asignada'].includes(record.estado.raw_value) and record.dias_pendiente.raw_value"
                             t-attf-class="small fw-bold #{record.dias_pendiente.raw_value > 7 ? 'text-danger' : 'text-muted'}">
                            <i class="fa fa-clock-o me-1" title="Antigüedad"/><field name="dias_pendiente"/> días
                        </div>
                        <div t-if="record.estado.raw_value == 'garantia'" class="small fw-bold text-danger"><i class="fa fa-shield me-1" title="Garantía"/>Visita por garantía</div>
                        <div t-if="record.vehiculo_id.value" class="small"><i class="fa fa-car me-1" title="Vehículo"/><field name="vehiculo_id"/></div>
                        <field name="tecnico_asignado_ids" widget="many2many_tags"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <footer class="align-items-center">
                            <field name="fecha"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- BÚSQUEDA -->
    <record id="view_atc_visita_search" model="ir.ui.view">
        <field name="name">atc.visita.search</field>
        <field name="model">atc.visita</field>
        <field name="arch" type="xml">
            <search string="Órdenes ATC">
                <field name="cedula"/>
                <field name="nombre"/>
                <field name="cliente_id"/>
                <field name="franquicia_id"/>
                <field name="zona_id"/>
                <field name="vgt_id"/>
                <field name="tecnico_asignado_ids"/>
                <field name="vehiculo_id"/>
                <field name="tecnico_id"/>
                <field name="contratista_id"/>
                <field name="vendedor_id"/>
                <field name="tipo_servicio_id"/>
                <field name="precinto"/>
                <field name="motivo_no_realizada_ids"/>
                <field name="direccion"/>
                <filter string="Visitas Técnicas" name="f_visitas" domain="[('tipo_orden','=','visita')]"/>
                <filter string="Instalaciones" name="f_instalaciones" domain="[('tipo_orden','=','instalacion')]"/>
                <separator/>
                <filter string="Pendiente" name="f_pendiente" domain="[('estado','=','pendiente')]"/>
                <filter string="Asignada" name="f_asignada" domain="[('estado','=','asignada')]"/>
                <filter string="Realizada" name="f_realizada" domain="[('estado','=','realizada')]"/>
                <filter string="No realizada" name="f_no_realizada" domain="[('estado','=','no_realizada')]"/>
                <filter string="Visita por garantía" name="f_garantia" domain="[('estado','=','garantia')]"/>
                <separator/>
                <filter string="Abiertas" name="f_abiertas" domain="[('estado','in',('pendiente','asignada','garantia'))]"/>
                <filter string="Abiertas con más de 7 días" name="f_vencidas"
                        domain="[('estado','in',('pendiente','asignada')), ('fecha_asignacion','&lt;', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="Sin contratista" name="f_sin_contratista"
                        domain="[('tipo_orden','=','instalacion'), ('contratista_id','=',False)]"/>
                <separator/>
                <filter string="Asignadas a mí" name="f_asignadas_mias" domain="[('tecnico_asignado_ids.user_id','=',uid)]"/>
                <filter string="Atendidas por mí" name="f_mias" domain="[('tecnico_id','=',uid)]"/>
                <separator/>
                <group>
                    <filter string="Tipo de orden" name="g_tipo" context="{'group_by':'tipo_orden'}"/>
                    <filter string="Estado" name="g_estado" context="{'group_by':'estado'}"/>
                    <filter string="Contratista" name="g_contratista" context="{'group_by':'contratista_id'}"/>
                    <filter string="Vendedor" name="g_vendedor" context="{'group_by':'vendedor_id'}"/>
                    <filter string="Tipo de servicio" name="g_tipo_servicio" context="{'group_by':'tipo_servicio_id'}"/>
                    <filter string="Motivo (no realizada)" name="g_motivo" context="{'group_by':'motivo_no_realizada_ids'}"/>
                    <filter string="Franquicia" name="g_franquicia" context="{'group_by':'franquicia_id'}"/>
                    <filter string="Zona" name="g_zona" context="{'group_by':'zona_id'}"/>
                    <filter string="VGT" name="g_vgt" context="{'group_by':'vgt_id'}"/>
                    <filter string="Asignado a" name="g_asignado" context="{'group_by':'tecnico_asignado_ids'}"/>
                    <filter string="Vehículo" name="g_vehiculo" context="{'group_by':'vehiculo_id'}"/>
                    <filter string="Atendido por" name="g_tecnico" context="{'group_by':'tecnico_id'}"/>
                    <filter string="Cliente ISP" name="g_cliente" context="{'group_by':'cliente_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACCIÓN: Visitas Técnicas -->
    <record id="action_atc_visita" model="ir.actions.act_window">
        <field name="name">Visitas Técnicas</field>
        <field name="res_model">atc.visita</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_atc_visita_search"/>
        <field name="domain">[('tipo_orden', '=', 'visita')]</field>
        <field name="context">{'default_tipo_orden': 'visita'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay visitas técnicas registradas.</p>
            <p>Crea una visita para llevar el control de las atenciones a clientes del ISP.</p>
        </field>
    </record>

    <!-- LISTA de instalaciones (contratistas) -->
    <record id="view_atc_instalacion_list" model="ir.ui.view">
        <field name="name">atc.visita.instalacion.list</field>
        <field name="model">atc.visita</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Instalaciones"
                  decoration-muted="estado in ('realizada', 'no_realizada')"
                  decoration-danger="estado in ('pendiente', 'asignada') and dias_pendiente &gt; 7">
                <field name="fecha_asignacion"/>
                <field name="dias_pendiente" string="Días"/>
                <field name="contratista_id"/>
                <field name="vendedor_id" optional="show"/>
                <field name="tipo_servicio_id" optional="show"/>
                <field name="cedula"/>
                <field name="nombre"/>
                <field name="telefono_movil" optional="show"/>
                <field name="telefono_fijo" optional="hide"/>
                <field name="franquicia_id" optional="show"/>
                <field name="zona_id" optional="show"/>
                <field name="direccion" optional="show"/>
                <field name="fecha_programada" optional="show"/>
                <field name="fecha_instalacion" optional="hide"/>
                <field name="tecnico_contratista" optional="hide"/>
                <field name="serial_onu" optional="hide"/>
                <field name="precinto" optional="hide"/>
                <field name="potencia_rx" optional="hide"/>
                <field name="caja_nap" optional="hide"/>
                <field name="metros_fibra" optional="hide" sum="Total"/>
                <field name="cliente_mapa_url" widget="url" text="Mapa" optional="hide"/>
                <field name="nap_mapa_url" widget="url" text="Mapa" optional="hide"/>
                <field name="motivo_no_realizada_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}" optional="show"/>
                <field name="estado" widget="badge"
                       decoration-success="estado == 'realizada'"
                       decoration-info="estado == 'asignada'"
                       decoration-warning="estado == 'pendiente'"
                       decoration-danger="estado in ('no_realizada', 'garantia')"/>
            </list>
        </field>
    </record>

    <record id="view_atc_instalacion_pivot" model="ir.ui.view">
        <field name="name">atc.visita.instalacion.pivot</field>
        <field name="model">atc.visita</field>
        <field name="arch" type="xml">
            <pivot string="Instalaciones por contratista" sample="1">
                <field name="contratista_id" type="row"/>
                <field name="estado" type="col"/>
                <field name="dias_instalacion" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_atc_instalacion_graph" model="ir.ui.view">
        <field name="name">atc.visita.instalacion.graph</field>
        <field name="model">atc.visita</field>
        <field name="arch" type="xml">
            <graph string="Instalaciones por contratista" type="bar" stacked="1" sample="1">
                <field name="contratista_id"/>
                <field name="estado"/>
            </graph>
        </field>
    </record>

    <!-- ACCIÓN: Instalaciones -->
    <record id="action_atc_instalacion" model="ir.actions.act_window">
        <field name="name">Instalaciones</field>
        <field name="res_model">atc.visita</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_atc_instalacion_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_atc_visita_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_atc_visita_form')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_atc_instalacion_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_atc_instalacion_graph')})]"/>
        <field name="search_view_id" ref="view_atc_visita_search"/>
        <field name="domain">[('tipo_orden', '=', 'instalacion')]</field>
        <field name="context">{'default_tipo_orden': 'instalacion'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay instalaciones registradas.</p>
            <p>Crea una instalación para asignarla a los técnicos.</p>
        </field>
    </record>
</odoo>
