<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_atc_franquicia_list" model="ir.ui.view">
        <field name="name">atc.franquicia.list</field>
        <field name="model">atc.franquicia</field>
        <field name="arch" type="xml">
            <list string="Franquicias">
                <field name="name"/>
                <field name="code"/>
                <field name="zona_count"/>
            </list>
        </field>
    </record>

    <record id="view_atc_franquicia_form" model="ir.ui.view">
        <field name="name">atc.franquicia.form</field>
        <field name="model">atc.franquicia</field>
        <field name="arch" type="xml">
            <form string="Franquicia">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <group string="Zonas de esta franquicia">
                        <field name="zona_ids" nolabel="1" colspan="2"
                               options="{'no_create': True}">
                            <list string="Zonas">
                                <field name="name"/>
                                <field name="code"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_atc_franquicia" model="ir.actions.act_window">
        <field name="name">Franquicias (sedes)</field>
        <field name="res_model">atc.franquicia</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la primera franquicia</p>
            <p>Una franquicia (sede) agrupa varias zonas. Asigna a cada zona su
               franquicia para que las órdenes la tomen solas.</p>
        </field>
    </record>
</odoo>
